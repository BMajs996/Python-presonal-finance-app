# Template only. Replace the example domain and configure the owner hash locally.
ENVIRONMENT=production
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=
CORS_ORIGINS=https://finance.example.com
ALLOWED_HOSTS=finance.example.com
TRUSTED_PROXY_IPS=127.0.0.1
APP_PORT=8000
BUSINESS_TIMEZONE=Europe/Belgrade
RECURRING_INTERVAL_SECONDS=60
RECURRING_MAX_BACKOFF_SECONDS=300
RECURRING_STALE_SECONDS=180
RECURRING_FAILURE_THRESHOLD=3
RECURRING_LAG_DAYS=1
BASE_CURRENCY=USD
# Same-host PostgreSQL Unix socket with a dedicated finance role/database.
DATABASE_URL=postgresql:///finance_dashboard
DATABASE_PATH=/var/lib/finance-dashboard/personal_finance.db
