# Leave blank to use SQLite. For local PostgreSQL, use postgresql:///finance_dashboard.
DATABASE_URL=
BASE_CURRENCY=USD
# Financial calendar; independent of the host timezone. Requires system IANA tzdata.
BUSINESS_TIMEZONE=Europe/Belgrade

# Configure locally with python -m backend.app.setup_owner (never store a plaintext password).
OWNER_USERNAME=owner
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Exact request hostnames, not origins or wildcard patterns.
ALLOWED_HOSTS=localhost,127.0.0.1
# Production launcher requires exact trusted proxy IPs; blank is safe for development.
TRUSTED_PROXY_IPS=
APP_PORT=8000
SESSION_SECONDS=28800
SESSION_IDLE_SECONDS=1800
